---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../content/profile';
import { projects } from '../content/projects';

const contacts = [
  { label: 'Email', value: profile.emailAddress, href: profile.links.email, external: false },
  { label: 'Telegram', value: profile.telegramHandle, href: profile.links.telegram, external: true },
  { label: 'LinkedIn', value: 'denis-gaivoronskii', href: profile.links.linkedin, external: true },
];
---

<Layout title={`${profile.brand} | ${profile.headline}`} description={profile.pitch}>
  <Hero />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="pixel text-[10px] uppercase text-neon sm:text-xs">What I take on</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {profile.services.map((service) => (
        <article class="panel-surface rounded-3xl p-6">
          <h2 class="text-lg font-semibold text-white">{service.title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">{service.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="work" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-8 sm:px-6 lg:px-8">
    <p class="pixel text-[10px] uppercase text-neon sm:text-xs">Selected work</p>
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-7xl scroll-mt-24 px-4 pb-20 pt-16 sm:px-6 lg:px-8">
    <div class="panel-surface rounded-3xl p-6 sm:p-10">
      <p class="pixel text-[10px] uppercase text-neon sm:text-xs">Hire me</p>
      <h2 class="mt-4 text-2xl font-semibold text-white sm:text-3xl">Have something in mind?</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">
        Describe the business problem in a few sentences — what you sell or run, what hurts, and what a good result looks
        like. No spec needed.
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        {contacts.map((contact) => (
          <a
            href={contact.href}
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noreferrer' : undefined}
            class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 transition hover:border-neon/40 hover:bg-neon/10"
          >
            <span class="block text-xs uppercase tracking-[0.24em] text-slate-400">{contact.label}</span>
            <span class="mt-1 block font-medium text-neon">{contact.value}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
