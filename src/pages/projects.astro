---
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../content/projects';
import { profile } from '../content/profile';
---

<Layout title={`${profile.brand} | Projects`} description="Products and integrations taken to production.">
  <section class="mx-auto max-w-7xl px-4 pb-8 pt-10 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Projects</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Selected work</h1>
      <p class="mt-4 text-base leading-7 text-slate-300">
        Products and integrations I built and took to production.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>

