---
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { projects } from '../content/projects';
import { skills } from '../content/skills';
import { education } from '../content/education';
import { profile } from '../content/profile';
---

<Layout title={`${profile.brand} | Classic CV`} description="Classic CV view for recruiters and clients.">
  <section class="mx-auto max-w-5xl px-4 pb-8 pt-10 sm:px-6 lg:px-8">
    <div class="panel-surface rounded-3xl p-6 sm:p-8">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Classic CV</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{profile.name}</h1>
      <p class="mt-3 text-lg text-slate-300">{profile.role}</p>
      <p class="mt-5 max-w-3xl text-sm leading-7 text-slate-300">{profile.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={profile.links.github} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">GitHub</a>
        <a href={profile.links.linkedin} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">LinkedIn</a>
        <a href={profile.links.email} class="rounded-full border border-neon/30 bg-neon/10 px-4 py-2 text-sm text-neon">Email</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-5">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Selected work</p>
      <h2 class="mt-2 text-2xl font-semibold text-white">What I built</h2>
    </div>
    <div class="space-y-4">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-5">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Skills</p>
      <h2 class="mt-2 text-2xl font-semibold text-white">Technical and leadership scope</h2>
    </div>
    <div class="space-y-4">
      {skills.map((group) => (
        <div class="panel-surface rounded-3xl p-5">
          <h3 class="text-lg font-semibold text-white">{group.title}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <SkillBadge label={item} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-5">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Education</p>
      <h2 class="mt-2 text-2xl font-semibold text-white">Training and formal study</h2>
    </div>
    <div class="space-y-4">
      {education.map((item) => (
        <article class="panel-surface rounded-3xl p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold text-white">{item.institution}</h3>
              <p class="mt-1 text-sm text-slate-400">{item.program}</p>
            </div>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">{item.period}</span>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-slate-300">
            {item.notes.map((note) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-neon" />
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Layout>

