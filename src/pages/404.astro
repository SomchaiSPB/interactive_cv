---
import Layout from '../components/Layout.astro';
import { profile } from '../content/profile';
---

<Layout title={`${profile.name} | Page not found`} description="This page does not exist." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="mono text-xs uppercase tracking-[0.28em] text-neon">404</p>
    <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">This road leads nowhere</h1>
    <p class="mt-4 text-base leading-7 text-slate-300">The page you are looking for does not exist.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full border border-neon/40 bg-neon/10 px-5 py-3 text-sm font-medium text-neon transition hover:bg-neon/15">Back home</a>
      <a href="/play" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-slate-200 transition hover:border-neon/30 hover:bg-white/10">Explore the quest</a>
    </div>
  </section>
</Layout>
