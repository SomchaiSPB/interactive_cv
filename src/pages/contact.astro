---
import Layout from '../components/Layout.astro';
import { profile } from '../content/profile';
---

<Layout title={`${profile.name} | Contact`} description="Contact details and professional links.">
  <section class="mx-auto max-w-4xl px-4 pb-8 pt-10 sm:px-6 lg:px-8">
    <div class="panel-surface rounded-3xl p-6 sm:p-8">
      <p class="mono text-xs uppercase tracking-[0.28em] text-neon">Contact Portal</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Reach Denis directly</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">
        The fastest route for recruiter, client, or technical lead outreach is through the classic CV links below.
      </p>
      <div class="mt-6 space-y-3">
        <a class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-slate-200 transition hover:border-neon/30 hover:bg-white/10" href={profile.links.github}>
          GitHub: {profile.links.github.replace('https://', '')}
        </a>
        <a class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-slate-200 transition hover:border-neon/30 hover:bg-white/10" href={profile.links.linkedin}>
          LinkedIn: {profile.links.linkedin.replace('https://', '')}
        </a>
        <a class="block rounded-2xl border border-neon/30 bg-neon/10 px-5 py-4 text-neon transition hover:bg-neon/15" href={profile.links.email}>
          Email: denis.gaivoronskii@example.com
        </a>
      </div>
    </div>
  </section>
</Layout>

