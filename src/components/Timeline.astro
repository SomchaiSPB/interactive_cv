---
import type { Checkpoint } from '../content/types';

type Props = {
  items: Checkpoint[];
};

const { items } = Astro.props satisfies Props;
---

<section class="space-y-4">
  {items.map((item) => (
    <article class="panel-surface rounded-3xl p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="mono text-xs uppercase tracking-[0.28em] text-neon">{item.order.toString().padStart(2, '0')}</p>
          <h3 class="mt-2 text-lg font-semibold text-white">{item.title}</h3>
          <p class="mt-1 text-sm uppercase tracking-[0.18em] text-slate-400">{item.subtitle}</p>
        </div>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] uppercase tracking-[0.24em] text-slate-400">
          {item.side}
        </span>
      </div>
      <p class="mt-4 text-sm leading-7 text-slate-300">{item.summary}</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        {item.details.slice(0, 2).map((detail) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-neon" />
            <span>{detail}</span>
          </li>
        ))}
      </ul>
      <div class="mt-4 flex flex-wrap gap-2">
        {item.technologies.map((tech) => (
          <span class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-slate-200">
            {tech}
          </span>
        ))}
      </div>
    </article>
  ))}
</section>

