---
import '../styles/global.css';
import { profile } from '../content/profile';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.pitch,
  noindex = false,
} = Astro.props satisfies Props;

// build.format 'file' reports /projects.html; public URLs are /projects.
const pathname = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';

const canonicalUrl = new URL(pathname, Astro.site);
const ogImageUrl = new URL('/og.png', Astro.site);
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.pitch,
  url: profile.links.website,
  email: profile.emailAddress,
  image: ogImageUrl.href,
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.telegram],
});


const isGame = pathname.startsWith('/play');

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'CV', href: '/cv' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
  { label: 'Quest', href: '/play' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="theme-color" content="#070b14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={personJsonLd} />
  </head>
  <body>
    <div class="page-shell min-h-screen">
      {!isGame ? (
        <header class="sticky top-0 z-40 border-b border-white/5 bg-slate-950/75 backdrop-blur-xl">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
            <a href="/" class="group flex items-center gap-3">
              <span class="pixel-border flex h-10 w-10 items-center justify-center rounded-lg bg-slate-900/90 text-sm font-bold text-neon">
                DG
              </span>
              <span>
                <span class="block text-sm font-semibold tracking-[0.24em] text-neon">{profile.name.toUpperCase()}</span>
                <span class="block text-xs uppercase tracking-[0.28em] text-slate-400">Software engineer for hire</span>
              </span>
            </a>
            <nav class="hidden items-center gap-2 md:flex">
              {navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'rounded-full border px-4 py-2 text-sm transition',
                    pathname === item.href || pathname === `${item.href}/`
                      ? 'border-neon/50 bg-neon/10 text-neon'
                      : 'border-white/10 text-slate-300 hover:border-neon/30 hover:text-white',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </header>
      ) : null}
      <main>
        <slot />
      </main>
      {!isGame ? (
        <footer class="border-t border-white/5 bg-black/20">
          <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm text-slate-400 sm:px-6 lg:px-8 md:flex-row md:items-center md:justify-between">
            <p>© {new Date().getFullYear()} {profile.name}</p>
            <a href={profile.links.email} class="hover:text-neon">{profile.emailAddress}</a>
          </div>
        </footer>
      ) : null}
    </div>
  </body>
</html>
