---
import type { Project } from '../content/types';

type Props = {
  project: Project;
};

const { project } = Astro.props satisfies Props;
---

<article class="panel-surface flex h-full flex-col overflow-hidden rounded-3xl">
  {project.image && (
    <a href={project.links?.[0]?.href ?? project.image.src} target="_blank" rel="noreferrer" class="block border-b border-white/10 bg-black/30">
      <img src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover object-top" />
    </a>
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-xl font-semibold text-white">{project.title}</h3>
      <span class="shrink-0 rounded-full border border-neon/30 bg-neon/10 px-3 py-1 text-[11px] uppercase tracking-[0.24em] text-neon">
        {project.status}
      </span>
    </div>
    <p class="mt-4 text-sm leading-7 text-slate-300">{project.summary}</p>
    <div class="mt-5 space-y-3 text-sm text-slate-400">
      <p><span class="font-semibold text-slate-200">Problem:</span> {project.problem}</p>
      <p><span class="font-semibold text-slate-200">What I did:</span> {project.whatBuilt}</p>
      <p><span class="font-semibold text-slate-200">Result:</span> {project.result}</p>
    </div>
    <div class="mt-auto pt-5">
      <div class="flex flex-wrap gap-2">
        {project.stack.map((tech) => (
          <span class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-slate-200">
            {tech}
          </span>
        ))}
      </div>
      {project.links?.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noreferrer' : undefined}
          class="mt-4 inline-block text-sm font-medium text-neon hover:underline"
        >
          {link.label} ↗
        </a>
      ))}
    </div>
  </div>
</article>
