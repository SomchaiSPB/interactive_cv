---
import { profile } from '../content/profile';
---

<section class="mx-auto max-w-7xl px-4 pb-10 pt-10 sm:px-6 lg:px-8 lg:pt-16">
  <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-neon/20 bg-neon/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-neon">
        {profile.headline}
      </div>
      <div class="space-y-4">
        <h1 class="max-w-4xl text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
          {profile.name}
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">
          {profile.role}
        </p>
        <p class="max-w-3xl text-base leading-7 text-slate-300 sm:text-lg">
          {profile.pitch}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        {profile.ctaLinks.map((link, index) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
            class:list={[
              'rounded-full border px-5 py-3 text-sm font-medium transition',
              index === 0
                ? 'border-neon/40 bg-neon/10 text-neon hover:bg-neon/15'
                : 'border-white/10 bg-white/5 text-slate-200 hover:border-neon/30 hover:bg-white/10',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <aside class="panel-surface rounded-3xl p-6">
      <p class="text-sm leading-7 text-slate-200">{profile.summary}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {profile.quickFacts.map((fact) => (
          <span class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-slate-200">
            {fact}
          </span>
        ))}
      </div>
    </aside>
  </div>
</section>
