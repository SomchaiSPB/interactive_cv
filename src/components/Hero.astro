---
import { profile } from '../content/profile';

const [start, ...menu] = profile.ctaLinks;
---

<section class="crt flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden">
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center px-4 py-12 text-center sm:px-6">
    <p class="pixel text-[10px] uppercase text-slate-400 sm:text-xs">{profile.headline}</p>

    <h1 class="pixel title-logo mt-8 text-[28px] uppercase leading-tight sm:text-5xl lg:text-6xl">
      {profile.brand}
    </h1>

    <p class="mt-8 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">{profile.pitch}</p>

    <div class="mt-4 flex flex-col items-center sm:flex-row sm:gap-6">
      <div class="hero-sprite -my-12 shrink-0 scale-75 sm:scale-100" role="img" aria-label="Pixel-art adventurer from the quest"></div>
      <a href={start.href} class="press-start pixel text-sm uppercase sm:text-lg">
        <span class="blink" aria-hidden="true">▶</span>
        {start.label}
      </a>
    </div>

    <nav class="console-menu pixel mt-10 flex flex-col items-center gap-5 text-xs uppercase sm:flex-row sm:gap-12" aria-label="More">
      {menu.map((link) => (
        <a href={link.href} class="text-slate-300 transition-colors hover:text-white focus-visible:text-white focus-visible:outline-none">
          {link.label}
        </a>
      ))}
    </nav>

    <p class="mono mt-10 text-xs uppercase tracking-[0.24em] text-slate-500">
      Click or tap to walk
    </p>
  </div>
</section>
